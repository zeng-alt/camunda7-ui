{
  "name": "@zeng-alt/camunda7-ui",
  "version": "1.0.1",
  "private": false,
  "type": "module",
  "main": "./dist/camunda7-ui.umd.js",
  "module": "./dist/camunda7-ui.es.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/camunda7-ui.css",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/camunda7-ui.es.js",
      "require": "./dist/camunda7-ui.umd.js"
    },
    "./style.css": "./dist/camunda7-ui.css"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite --open /start.html",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "oxfmt src/"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bpmn-font": "^0.12.1",
    "bpmn-js": "18.14.0",
    "bpmn-js-bpmnlint": "^0.24.0",
    "bpmn-moddle": "^10.0.0",
    "bpmnlint": "^11.12.1",
    "camunda-bpmn-js": "5.11.0",
    "camunda-bpmn-moddle": "7.0.1",
    "camunda-dmn-js": "3.4.0",
    "diagram-js": "15.11.0",
    "tiny-svg": "4.1.4"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.9.2",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.2",
    "@vueuse/core": ">=13.0.0",
    "naive-ui": ">=2.44.1",
    "vue": ">=3.5.13"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.9.2",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.2",
    "@iconify-json/ic": "^1.2.4",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.0",
    "@unocss/preset-rem-to-px": "^66.6.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.42.0",
    "typescript": "~5.9.0",
    "unocss": "^66.6.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "Camunda 7 UI components for Vue 3 - BPMN modeler, DMN viewer, and process management UI",
  "keywords": [
    "camunda",
    "bpmn",
    "dmn",
    "workflow",
    "vue",
    "vue3",
    "ui",
    "components"
  ],
  "homepage": "https://github.com/zeng-alt/camunda7-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeng-alt/camunda7-ui.git"
