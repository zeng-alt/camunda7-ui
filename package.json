{
  "name": "camunda7-ui",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "main": "./dist/camunda7-ui.umd.js",
  "module": "./dist/camunda7-ui.es.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/camunda7-ui.css",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/camunda7-ui.es.js",
      "require": "./dist/camunda7-ui.umd.js"
    },
    "./style.css": "./dist/camunda7-ui.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "oxfmt src/"
  },
  "dependencies": {
    "@iconify-json/ic": "^1.2.4",
    "bpmn-font": "^0.12.1",
    "bpmn-moddle": "^10.0.0",
    "camunda-bpmn-js": "5.11.0",
    "camunda-bpmn-moddle": "7.0.1",
    "camunda-dmn-js": "3.4.0"
  },
  "peerDependencies": {
    "@vueuse/core": ">=13.0.0",
    "naive-ui": ">=2.44.1",
    "vue": ">=3.5.31",
    "vue-i18n": ">=11.3.2"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.0",
    "@unocss/preset-rem-to-px": "^66.6.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.2.1",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.42.0",
    "typescript": "~6.0.0",
    "unocss": "^66.6.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "Camunda 7 UI components for Vue 3 - BPMN modeler, DMN viewer, and process management UI",
  "keywords": [
    "camunda",
    "bpmn",
    "dmn",
    "workflow",
    "vue",
    "vue3",
    "ui",
    "components"
  ],
  "homepage": "https://github.com/YOUR_USERNAME/camunda7-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_USERNAME/camunda7-ui.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/camunda7-ui/issues"
  },
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
